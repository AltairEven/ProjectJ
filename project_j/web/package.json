{
  "name": "project-j-p0-web-baseline",
  "version": "0.0.0",
  "private": true,
  "description": "Project J parent workbench and isolated fictional classroom",
  "packageManager": "npm@11.20.0",
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "26.11.1",
      "onFail": "error"
    },
    "packageManager": {
      "name": "npm",
      "version": "11.20.0",
      "onFail": "error"
    }
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "remark": "^15.0.1",
    "remark-validate-links": "^13.1.0",
    "typescript": "^7.0.2",
    "unified-engine": "^11.2.2",
    "vite": "^8.3.4",
    "@types/node": "^24.13.3",
    "@vitejs/plugin-react": "^6.1.1"
  },
  "scripts": {
    "test:interface": "node --test tests/*.test.mjs",
    "check:types": "tsc -b --pretty false && tsc --noEmit -p tsconfig.fixtures.json",
    "test:docs": "node --test check_docs.test.mjs",
    "check:docs": "node check_docs.mjs",
    "build": "tsc -b && vite build",
    "generate:api": "npm --prefix codegen run generate"
  },
  "type": "module"
}
